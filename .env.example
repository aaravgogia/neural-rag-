# ── Backend (full production: app.main:app) ──────────────────────────────
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
# Choose openai, anthropic, mistral, gemini, or auto. auto tries providers in that order;
# without a usable key the non-production app uses StubLLM.
LLM_PROVIDER=auto
LLM_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
MISTRAL_MODEL=mistral-small-latest
GEMINI_MODEL=gemini-2.5-flash
# Optional OTLP/HTTP collector endpoint. Leave blank for no-op local tracing.
OTEL_EXPORTER_ENDPOINT=
OTEL_CONSOLE_EXPORTER=false
# PII redaction runs before chunks reach embeddings. Install the spaCy model
# in the full production image: python -m spacy download en_core_web_sm
PII_REDACTION_ENABLED=true
PRESIDIO_SPACY_MODEL=en_core_web_sm
# sentence_transformers (default) uses all-MiniLM-L6-v2 locally; select openai for OpenAI embeddings.
EMBEDDING_PROVIDER=sentence_transformers
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
EMBEDDING_MODEL=text-embedding-3-small
# chroma is the default. pgvector requires PostgreSQL with the pgvector
# extension and EMBEDDING_PROVIDER=openai (1536-dimension embeddings).
VECTOR_STORE_PROVIDER=chroma
PGVECTOR_TABLE_NAME=vector_embeddings
PGVECTOR_DIMENSIONS=1536
# Cross-encoder reranking is applied only for pro workspaces.
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# If document retrieval relevance is below this value, the agent can supplement context from the web.
RETRIEVAL_CONFIDENCE_THRESHOLD=0.35
# Optional external search: auto/tavily. With no key, this branch skips safely.
WEB_SEARCH_PROVIDER=auto
TAVILY_API_KEY=
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
SECRET_KEY=change-this-to-a-random-secret
DATABASE_URL=postgresql+asyncpg://user:password@postgres/ragdb
REDIS_URL=redis://redis:6379
# Share WebSocket room events across API instances when Redis is available.
WS_REDIS_BROADCAST_ENABLED=true
# This cap applies only to the public live-demo room, never authenticated rooms.
PUBLIC_DEMO_MAX_CONNECTIONS=50
# Generation endpoints use a Redis token bucket when Redis is reachable and
# gracefully fall back to local limiting otherwise.
AUTHENTICATED_CHAT_REQUESTS_PER_MINUTE=60
PUBLIC_DEMO_REQUESTS_PER_MINUTE=12
RATE_LIMIT_WINDOW_SECONDS=60
FRONTEND_URL=http://localhost:3000
# In production, list every permitted browser origin explicitly.
ALLOWED_ORIGINS=https://app.example.com

# ── Frontend (Vite -- MUST be prefixed with VITE_, not REACT_APP_) ───────
# Local dev: leave unset, both default to localhost:8000
# Production: set these as BUILD-TIME env vars on Vercel/Netlify -- Vite
# bakes them into the bundle at build time, they are NOT read at runtime.
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
